# BhuVerify — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env with real keys to version control.
#
# Local Development:
#   Copy to Bihar_Land_OCR_Dataset/.env and set GEMINI_API_KEY
#
# Netlify / Production:
#   Set GEMINI_API_KEY in Netlify → Site Settings → Environment Variables

# ──────────────────────────────────────────────────
# Google Gemini API
# ──────────────────────────────────────────────────
GEMINI_API_KEY=

# Optional: Override the Gemini model (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# ──────────────────────────────────────────────────
# Server Configuration
# ──────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ──────────────────────────────────────────────────
# Optional: External OCR / Vision API key
# ──────────────────────────────────────────────────
OCR_API_KEY=

# ──────────────────────────────────────────────────
# Optional: Database URL (future use)
# ──────────────────────────────────────────────────
DATABASE_URL=
